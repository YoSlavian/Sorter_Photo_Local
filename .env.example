# Copy to .env and fill in only what you need.
# Nothing here is required: deterministic mode works with an empty file.

# Port the application is published on (docker compose).
PORT=8000

# ---------------------------------------------------------------------------
# AI and hybrid interpretation modes
# ---------------------------------------------------------------------------
# Which backend the AI modes use: anthropic | openai | local
BPMN_ARCHITECT_LLM_PROVIDER=anthropic

# Anthropic (pip install "bpmn-architect[anthropic]")
ANTHROPIC_API_KEY=

# OpenAI (pip install "bpmn-architect[openai]")
OPENAI_API_KEY=

# Override the provider's default model.
#   anthropic -> claude-opus-5
#   openai    -> gpt-4.1
#   local     -> llama3.1
BPMN_ARCHITECT_LLM_MODEL=

# For a local, OpenAI-compatible server (Ollama, vLLM, LM Studio, llama.cpp).
# BPMN_ARCHITECT_LLM_PROVIDER=local
# BPMN_ARCHITECT_LLM_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Serving
# ---------------------------------------------------------------------------
# Serve a frontend build from somewhere other than the package directory.
# BPMN_ARCHITECT_STATIC_DIR=/srv/bpmn-architect/static
